# Contact form delivery. Both values are public (they ship in the page), so
# never put a secret key here.
#
# A form endpoint that accepts JSON POSTs, e.g. Formspree: https://formspree.io/f/xxxxxxx
VITE_CONTACT_ENDPOINT=
# Optional: shown as an "email me instead" fallback when the endpoint is missing or fails.
VITE_CONTACT_EMAIL=
