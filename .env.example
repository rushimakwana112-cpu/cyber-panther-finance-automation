# ---------------------------------------------------------------------------
# Server-side (Vercel project → Settings → Environment Variables). SECRET —
# never commit real values, never prefix with VITE_.
# ---------------------------------------------------------------------------
# Resend API key (https://resend.com/api-keys) — "Sending access" is enough.
RESEND_API_KEY=
# Address that receives enquiries.
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "Cyber Panther <enquiries@yourdomain.com>".
# Leave empty to use Resend's test sender, which can only deliver to the
# email address of your own Resend account.
CONTACT_FROM_EMAIL=
# Optional: extra origins allowed to post (e.g. a custom domain alias). Same-origin is always allowed.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Public build-time values (shipped in the page). Never put secrets here.
# ---------------------------------------------------------------------------
# Optional: post the form somewhere other than this site's /api/contact.
VITE_CONTACT_ENDPOINT=
# Optional: public address for the "send via your email app" fallback.
VITE_CONTACT_EMAIL=
