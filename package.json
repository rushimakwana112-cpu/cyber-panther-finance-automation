{
  "name": "cyber-panther",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Cyber Panther — Finance & Automation. Portfolio site for Rushi.",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "tsc --noEmit && vite build",
